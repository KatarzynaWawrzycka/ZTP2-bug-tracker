{% extends 'base.html.twig' %}

{% block title %}
    {{ 'title.bug_list'|trans }}
{% endblock %}

{% block body %}
    <h1>{{ 'title.bug_list'|trans }}</h1>

    {% if is_granted('IS_AUTHENTICATED_FULLY') %}
        <a href="{{ url('bug_create') }}">
            {{ 'action.create'|trans }}
        </a>
    {% endif %}

    {% if pagination is defined and pagination.items|length %}

        <div class="navigation text-center">
            {{ knp_pagination_render(pagination) }}
        </div>

        <table class="table table-striped">
            <thead>
            <tr>
                <th>{{ knp_pagination_sortable(pagination, 'label.id'|trans, 'bug.id') }}</th>
                <th>{{ knp_pagination_sortable(pagination, 'label.created_at'|trans, 'bug.createdAt') }}</th>
                <th>{{ knp_pagination_sortable(pagination, 'label.updated_at'|trans, 'bug.updatedAt') }}</th>
                <th>{{ 'label.author'|trans }}</th>
                <th>{{ knp_pagination_sortable(pagination, 'label.title'|trans, 'bug.title') }}</th>
                <th>{{ knp_pagination_sortable(pagination, 'label.description'|trans, 'bug.description') }}</th>
                <th>{{ knp_pagination_sortable(pagination, 'label_category'|trans, 'category.title') }}</th>
                <th>{{ 'label.tags'|trans }}</th>
                <th>{{ 'label.status'|trans }}</th>
                <th>{{ 'label.assigned_to'|trans }}</th>
                <th>{{ 'label.actions'|trans }}</th>
            </tr>
            </thead>
            <tbody>
            {% for bug in pagination.items %}
                <tr>
                    <td>{{ bug.id }}</td>
                    <td>{{ bug.createdAt|format_date('long') }}</td>
                    <td>{{ bug.updatedAt|format_date('long') }}</td>
                    <td>{{ bug.author.email }}</td>
                    <td>{{ bug.title }}</td>
                    <td>{{ bug.description|slice(0, 50) ~ '...'}}</td>
                    <td>
                        <a
                           href="{{ url('bug_index', {'categoryId' : bug.category.id}) }}"
                           title="{{ bug.category.title }}">
                            {{ bug.category.title }}
                        </a>
                    </td>

                    <td>
                        {% if bug.tags is defined and bug.tags|length %}
                            {% for tag in bug.tags %}
                                <a
                                   href="{{ url('bug_index', {'tagId' : tag.id}) }}"
                                   title="{{ tag.title }}">
                                    {{ tag.title }}
                                </a>
                            {% endfor %}
                        {% else %}
                            &nbsp;
                        {% endif %}
                    </td>
                    <td>
                        {% set status = bug.statusEnum %}

                        {% if status %}
                            {{ status.label|trans }}
                        {% else %}
                            <span class="text-muted">{{ status.unknown|trans }}</span>
                        {% endif %}
                    </td>
                    <td>{{ bug.assignedTo ? bug.assignedTo.email : 'Unassigned'|trans }}</td>
                    <td>
                        <a href="{{ url('bug_view', {id: bug.id}) }}" title="{{ 'action.view'|trans }}">
                            {{ 'action.view'|trans }}
                        </a>
                        {% if is_granted('BUG_EDIT', bug) %}
                            <a href="{{ url('bug_edit', {id: bug.id}) }}" title="{{ 'action.edit'|trans }}">
                                {{ 'action.edit'|trans }}
                            </a>
                        {% endif %}
                        {% if is_granted('BUG_DELETE', bug) %}
                            <a href="{{ url('bug_delete', {id: bug.id}) }}" title="{{ 'action.delete'|trans }}">
                                {{ 'action.delete'|trans }}
                            </a>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        <div class="navigation text-center">
            {{ knp_pagination_render(pagination) }}
        </div>

    {% else %}
        <p>
            {% include 'default/_single_alert_message.html.twig' with {
                type: 'warning',
                message: 'message.empty_list'|trans
            } %}
        </p>
    {% endif %}
{% endblock %}
